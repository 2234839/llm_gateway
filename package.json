{
  "name": "llm-gateway",
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "perview": "pnpm build && ./llm-gateway",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run scripts/build.ts",
    "build:web": "vite build",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.0",
    "chart.js": "^4.5.1",
    "fastify": "^5.10.0",
    "jimp": "^1.6.1",
    "picomatch": "^4.0.5",
    "uuid": "^14.0.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.1.5",
    "vite-plugin-pilot": "^1.0.35"
  }
}
